# Copy to .env on each host and fill in the values for that specific box.
# This file is deliberately not committed (see .gitignore) — everything else
# in this repo is meant to deploy identically to every host.

# This box's own hostname, used to tag its metrics in InfluxDB/Grafana and to
# pick its MQTT client_id / sensor location where applicable.
HOSTNAME=

# GID of this host's `docker` group, so telegraf (running as non-root) can
# read /var/run/docker.sock for inputs.docker metrics. Find it with:
#   getent group docker
DOCKER_GID=
